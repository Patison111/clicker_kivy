#:import from_hex kivy.utils.get_color_from_hex

# ==== Палитра ====
#:set bg_color        "#12151d"   # основной тёмный фон
#:set card_color      "#1e2330"   # карточки/контейнеры
#:set accent_color    "#f2a541"   # янтарный акцент (кнопки)
#:set accent_dark     "#c17a1a"   # акцент в состоянии нажатия
#:set danger_color    "#e0574f"   # для EXIT
#:set danger_dark     "#a83f39"
#:set text_color      "#f5f6fa"
#:set muted_color     "#8b93a1"
#:set shadow_color    "#00000055"


<CustomButton@Button>:
    font_size: "20sp"
    bold: True
    color: from_hex(text_color)
    background_color: 0, 0, 0, 0
    background_normal: ""
    background_down: ""
    canvas.before:
        Color:
            rgba: from_hex(accent_dark) if self.state == "down" else from_hex(accent_color)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [16]


<DangerButton@Button>:
    font_size: "18sp"
    bold: True
    color: from_hex(text_color)
    background_color: 0, 0, 0, 0
    background_normal: ""
    background_down: ""
    canvas.before:
        Color:
            rgba: from_hex(danger_dark) if self.state == "down" else from_hex(danger_color)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [16]


<Block>:
    size_hint: 1, 0.55
    allow_stretch: True
    keep_ratio: True
    canvas.before:
        Color:
            rgba: from_hex(card_color)
        RoundedRectangle:
            pos: self.x + dp(6), self.y - dp(6)
            size: self.size
            radius: [24]
        Color:
            rgba: from_hex(shadow_color)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [24]


<Menu>:
    canvas.before:
        Color:
            rgba: from_hex(bg_color)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "32dp"
        spacing: "18dp"

        Widget:
            size_hint: 1, 0.15

        Label:
            text: "BLOCK CLICKER"
            font_size: "36sp"
            bold: True
            color: from_hex(accent_color)
            size_hint: 1, 0.2

        Widget:
            size_hint: 1, 0.1

        CustomButton:
            text: "PLAY"
            size_hint: 1, 0.15
            on_press: root.go_game()

        CustomButton:
            text: "SETTINGS"
            size_hint: 1, 0.15
            on_press: root.go_settings()

        DangerButton:
            text: "EXIT"
            size_hint: 1, 0.15
            on_press: root.go_exit()

        Widget:
            size_hint: 1, 0.2


<Game>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: from_hex(bg_color)
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: "vertical"
            padding: "20dp"
            spacing: "16dp"
            size_hint: 1, 1
            pos: 0, 0

            BoxLayout:
                orientation: "horizontal"
                size_hint: 1, 0.12
                canvas.before:
                    Color:
                        rgba: from_hex(card_color)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [18]
                padding: "16dp", "8dp"

                Label:
                    text: "Score: " + str(root.score)
                    font_size: "18sp"
                    bold: True
                    color: from_hex(text_color)

                Label:
                    text: "Clicks: " + str(app.click_currency)
                    font_size: "18sp"
                    bold: True
                    color: from_hex(accent_color)

            Label:
                id: buff_label
                text: ""
                font_size: "16sp"
                bold: True
                color: from_hex(accent_color)
                size_hint: 1, 0.08

            Block:
                id: block

            CustomButton:
                text: "MENU"
                size_hint: 1, 0.12
                on_press: root.go_menu()

        CustomButton:
            text: "SHOP"
            size_hint: None, None
            size: "64dp", "64dp"
            pos_hint: {"right": 0.95, "top": 0.97}
            font_size: "13sp"
            on_press: root.open_shop()
            canvas.before:
                Color:
                    rgba: from_hex(accent_dark) if self.state == "down" else from_hex(accent_color)
                Ellipse:
                    pos: self.pos
                    size: self.size


<Settings>:
    canvas.before:
        Color:
            rgba: from_hex(bg_color)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "32dp"
        spacing: "18dp"

        Widget:
            size_hint: 1, 0.2

        Label:
            text: "SETTINGS"
            font_size: "30sp"
            bold: True
            color: from_hex(accent_color)
            size_hint: 1, 0.2

        Label:
            text: "Nothing here yet —\nthis section is under construction"
            font_size: "16sp"
            color: from_hex(muted_color)
            halign: "center"
            size_hint: 1, 0.3

        Widget:
            size_hint: 1, 0.15

        CustomButton:
            text: "BACK"
            size_hint: 1, 0.15
            on_press: root.go_menu()

        Widget:
            size_hint: 1, 0.2
